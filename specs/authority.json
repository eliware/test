{
  "version": "8.0",
  "repositoryId": "eliware/test",
  "globalAuthorityMap": "../../docs/authority-map.json",
  "description": "Test-local authority distribution for validator specifications, implementation, and acceptance.",
  "subjects": [
    {
      "id": "test.validator-contract",
      "kind": "specification",
      "authority": { "path": "./directives.json" },
      "directives": [{ "path": "./directives.json", "ids": ["E-18"] }],
      "implementation": [{ "path": "../src", "role": "validator-implementation" }],
      "consumers": ["all repositories using eliware-test"],
      "reviewers": ["eliware/qa", "eliware/docs", "eliware/conventions"],
      "evidence": [],
      "notAuthoritativeFor": [
        "the policies being validated",
        "human acceptance",
        "release or deployment procedure"
      ],
      "status": "active"
    },
    {
      "id": "test.validation-acceptance",
      "kind": "test-suite",
      "authority": { "path": "../tests" },
      "directives": [{ "path": "./directives.json", "ids": ["E-18"] }],
      "implementation": [{ "path": "../tests", "role": "acceptance" }],
      "consumers": ["eliware/qa", "eliware/conventions"],
      "reviewers": ["eliware/qa"],
      "evidence": [],
      "notAuthoritativeFor": ["repository policy"],
      "status": "active"
    },
    {
      "id": "test.contracts",
      "kind": "contract-reference",
      "authority": { "path": "./contracts.json" },
      "directives": [{ "path": "./directives.json", "ids": ["E-18"] }],
      "implementation": [{ "path": "./contracts.json", "role": "normative-harness-contracts" }],
      "consumers": ["eliware/qa", "eliware/conventions"],
      "reviewers": ["eliware/qa"],
      "evidence": [
        { "path": "../tests/checks/general/E-1/E-1.25/A-1.25.0/A-1.25.1.test.mjs", "kind": "contract-validation" }
      ],
      "notAuthoritativeFor": ["repository policy", "release or deployment procedure"],
      "status": "active"
    }
  ]
}

{
  "version": "9.0.0",
  "description": "Schema for version 9.0.0 Eliware directive documents and records.",
  "record": {
    "type": "object",
    "required": ["id", "dos", "donts"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^(E|A)-[0-9]+(?:\\.[0-9]+)*$"
      },
      "dos": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "minItems": 1
      },
      "donts": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "minItems": 1
      },
      "directives": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/directive"
        },
        "minItems": 1
      },
      "examples": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["purpose", "markdown"],
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "markdown": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "$defs": {
    "directive": {
      "type": "object",
      "required": ["id", "dos", "donts"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(E|A)-[0-9]+(?:\\.[0-9]+)*$"
        },
        "dos": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "donts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "directives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/directive"
          },
          "minItems": 1
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["purpose", "markdown"],
            "properties": {
              "purpose": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "markdown": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "document": {
    "type": "object",
    "required": ["version", "description", "directives"],
    "properties": {
      "version": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "description": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "directives": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/directive"
        }
      }
    },
    "additionalProperties": false
  }
}

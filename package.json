{
    "name": "@eliware/test",
    "version": "3.0.0",
    "description": "Shared Jest testing, coverage enforcement, and Oxlint validation for Eliware Node.js projects",
    "keywords": [
        "eliware",
        "testing",
        "jest",
        "oxlint",
        "coverage",
        "coverage-enforcement",
        "tooling",
        "test-runner",
        "nodejs",
        "cli",
        "ci"
    ],
    "license": "MIT",
    "author": "Eliware",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/eliware/test.git"
    },
    "bugs": {
        "url": "https://github.com/eliware/test/issues"
    },
    "homepage": "https://github.com/eliware/test#readme",
    "type": "module",
    "bin": {
        "eliware-test": "./bin/eliware-test.mjs"
    },
    "files": [
        "bin",
        "src",
        "spec",
        "docs",
        "README.md",
        "SPEC.md",
        "LICENSE",
        "RELEASE_NOTES.md"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "test": "node bin/eliware-test.mjs",
        "test:timing": "node bin/eliware-test.mjs --debug-timing",
        "lint": "node bin/eliware-test.mjs --lint",
        "pack": "npm pack --dry-run"
    },
    "jest": {
        "collectCoverageFrom": [
            "src/**/*.mjs"
        ],
        "coverageReporters": [
            "text"
        ],
        "testPathIgnorePatterns": [
            "/test-fixtures/",
            "/old-test/"
        ]
    },
    "dependencies": {
        "jest": "^30.5.1",
        "oxlint": "^1.81.0"
    },
    "devDependencies": {
        "@types/jest": "latest"
    },
    "engines": {
        "node": ">=26"
    }
}

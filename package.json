{
    "name": "@eliware/test",
    "version": "2.1.1",
    "description": "Shared baseline Jest, coverage, and Oxlint tooling for Eliware Node.js projects",
    "keywords": [
        "eliware",
        "testing",
        "jest",
        "oxlint",
        "coverage",
        "tooling",
        "nodejs",
        "cli",
        "ci"
    ],
    "license": "UNLICENSED",
    "author": "Eliware",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/eliware/test.git"
    },
    "bugs": {
        "url": "https://github.com/eliware/test/issues"
    },
    "homepage": "https://github.com/eliware/test#readme",
    "type": "module",
    "bin": {
        "eliware-test": "./bin/eliware-test.mjs"
    },
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.mjs"
        }
    },
    "files": [
        "bin",
        "src",
        "index.mjs",
        "index.d.ts",
        "README.md",
        "LICENSE",
        "RELEASE_NOTES.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "test": "node bin/eliware-test.mjs",
        "lint": "node bin/eliware-test.mjs --lint",
        "typecheck": "tsc --noEmit",
        "pack": "npm pack --dry-run"
    },
    "jest": {
        "collectCoverageFrom": [
            "src/**/*.mjs"
        ],
        "coverageReporters": [
            "text"
        ],
        "testPathIgnorePatterns": [
            "/test-fixtures/"
        ]
    },
    "dependencies": {
        "jest": "^30.5.0",
        "oxlint": "^1.80.0"
    },
    "devDependencies": {
        "@types/jest": "latest",
        "typescript": "latest"
    },
    "engines": {
        "node": ">=26"
    }
}